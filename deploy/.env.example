# Скопируйте в deploy/.env и заполните. Файл .env НЕ коммитить.
SHOP_DOMAIN=shop.example.ru
ADMIN_DOMAIN=admin.shop.example.ru

# Сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

TIMEZONE=Europe/Moscow
FREE_COURIER_FROM=1500
COURIER_FEE=199
EXPRESS_FEE=149

# Альфа-Банк, интернет-эквайринг. Пока пусто — онлайн-оплата выключена, работает «при получении».
# Тест: https://alfa.rbsuat.com/payment/rest   Бой: https://pay.alfabank.ru/payment/rest
ALFA_API_URL=https://alfa.rbsuat.com/payment/rest
ALFA_USERNAME=
ALFA_PASSWORD=

# Геокодер для зоны доставки. Пусто — Nominatim (OSM, до 1 запроса/сек, укажите контактный email).
# Для нагрузки: ключ «JavaScript API и HTTP Геокодер» Яндекса.
YANDEX_GEOCODER_KEY=
GEOCODER_CONTACT_EMAIL=   # ваш настоящий email (адреса @example.* Nominatim блокирует)

# Вход по номеру телефона (SMS-код). Провайдер — SMS.ru: зарегистрируйтесь, пополните баланс,
# скопируйте api_id из личного кабинета. Без этих строк вход по SMS в проде отключён (работает вход по email).
SMS_PROVIDER=smsru
SMSRU_API_ID=
# SMS_SENDER=MyShop   # имя отправителя, если согласовано в SMS.ru (иначе — общий номер)

# Вход по коду на email: SMTP вашей почты (Яндекс 360: smtp.yandex.ru:465, пароль приложения;
# Mail.ru: smtp.mail.ru:465; Unisender Go / SendPulse — из их кабинета). Пусто — в проде вход по коду на почту
# отключён, вход по паролю работает.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Магазин <noreply@shop.example.ru>

# Витрина: название и контакты (шапка, подвал, «Контакты», микроразметка для поисковиков)
SHOP_NAME=FOODTOR
SHOP_PHONE=+7 (900) 000-00-00
SHOP_EMAIL=hello@shop.example.ru
