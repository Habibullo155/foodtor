# Ключи SMS и почты для сервера. Скопируйте в deploy/secrets.env, впишите значения и запустите:
#   ./scripts/set_secrets.sh
# Файл secrets.env в git не попадает. Пустая строка — значение на сервере не меняется.

# SMS.ru → «Программистам» → api_id
SMSRU_API_ID=
# Имя отправителя, если согласовано в SMS.ru (иначе оставьте пустым — придёт с общего номера)
SMS_SENDER=

# Почта, с которой уходят письма с кодами входа и уведомления.
# Яндекс 360: smtp.yandex.ru, порт 465, ssl. Пароль — «пароль приложения» (id.yandex.ru → Безопасность),
# не пароль от почты. Mail.ru для бизнеса: smtp.mail.ru, 465, ssl.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=no-reply@foodtor.ru
SMTP_PASSWORD=
SMTP_FROM=FOODTOR <no-reply@foodtor.ru>

# Ваш настоящий email — для сервиса карт при поиске адресов
GEOCODER_CONTACT_EMAIL=
