# Скопируйте в backend/.server-data/server.env и заполните — scripts/server.sh подхватит при запуске.
# Телефон, почта для покупателей, доставка и реквизиты — в админке («Магазин и доставка»).

SHOP_NAME=FOODTOR

# SMS-коды для входа покупателей: https://sms.ru → api_id в личном кабинете. Без него вход по SMS не работает
SMS_PROVIDER=smsru
SMSRU_API_ID=
SMS_SENDER=

# Письма с кодом входа (необязательно). Для почты на Яндекс 360: smtp.yandex.ru, порт 465,
# пароль — «пароль приложения» из настроек аккаунта, не обычный пароль от почты
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=no-reply@foodtor.ru
SMTP_PASSWORD=
SMTP_FROM=FOODTOR <no-reply@foodtor.ru>

# Контакт для геокодера OpenStreetMap (их правила) — ваша почта
GEOCODER_CONTACT_EMAIL=
